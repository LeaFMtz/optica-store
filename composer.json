{
  "name": "lunarphp/livewire-starter-kit",
  "type": "project",
  "description": "Livewire starter kit for Lunar e-commerce.",
  "keywords": [
    "lunar",
    "ecommerce",
    "e-commerce",
    "livewire",
    "laravel"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "guzzlehttp/guzzle": "^7.2",
    "http-interop/http-factory-guzzle": "^1.2",
    "inertiajs/inertia-laravel": "^3.0",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^3.3|^4.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "lunarphp/lunar": "^1.5.0-beta.3",
    "lunarphp/table-rate-shipping": "^1.0",
    "meilisearch/meilisearch-php": "^1.6",
    "mercadopago/dx-php": "^3.9",
    "predis/predis": "^2.2",
    "tightenco/ziggy": "^2.6"
  },
  "require-dev": {
    "barryvdh/laravel-ide-helper": "^3.6",
    "laravel/tinker": "^3.0",
    "fakerphp/faker": "^1.23",
    "laravel/boost": "^2.4",
    "laravel/pint": "^1.29",
    "mockery/mockery": "^1.4.4",
    "nunomaduro/collision": "^8.9.4",
    "phpunit/phpunit": "^12.0",
    "spatie/laravel-ignition": "^2.12"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
